-
-    # Fusion-proof execution counter: thread a counting identity block
-    # through the graph so each chunk increments exactly once per
-    # execution, whatever the scheduler fuses the decode tasks into.
-    import threading
-    lock = threading.Lock()
-    counts = {"n": 0}
-
-    def _count(block):
